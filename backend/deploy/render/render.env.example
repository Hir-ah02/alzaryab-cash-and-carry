# ─────────────────────────────────────────────────────────────────────────────────────────────
# Render web service "alzaryab-api" — environment variables (STAGING). Reference only:
# enter the values in Render → service → Environment. NEVER put real values in this file or in Git.
# <angle-bracket> values are placeholders; Django refuses to start while any are left.
# ─────────────────────────────────────────────────────────────────────────────────────────────

# Runtime (Render): a full Python 3.13.x release that Render offers (the tests ran on 3.13;
# requirements-prod.lock also has wheels for 3.12).
PYTHON_VERSION=<PYTHON_3_13_X>

# Core
DJANGO_DEBUG=False
# Generate on your own computer and paste into Render (Render's "Generate" makes only 44 characters;
# Django requires 50+):   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=<GENERATE_ON_YOUR_COMPUTER>
# Optional: custom domains. Render's own *.onrender.com name is added automatically.
DJANGO_ALLOWED_HOSTS=
DJANGO_LOG_LEVEL=INFO

# Database: Supabase SESSION POOLER connection string, with the password filled in.
# Copy from Supabase → Connect → Session pooler. Paste ONLY into Render (mark it secret).
# Shape: postgresql://postgres.<project-ref>:<password>@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres
DATABASE_URL=<SUPABASE_SESSION_POOLER_URL>
# TLS with certificate verification. Upload Supabase's CA certificate as a Render "Secret File"
# named supabase-ca.crt (it is public; Secret File just keeps it out of Git). Render mounts it here:
DB_SSLMODE=verify-full
DB_SSLROOTCERT=/etc/secrets/supabase-ca.crt
DB_CONN_MAX_AGE=60

# Behind Render's load balancer
DJANGO_BEHIND_PROXY=true
FORWARDED_ALLOW_IPS=*
# Proxies writing X-Forwarded-For in front of Django. 1 is expected on Render: CONFIRM with the
# client-ip check (docs/DEPLOY_RENDER.md §5), then set LOG_CLIENT_IP_HEADERS=false.
TRUSTED_PROXY_COUNT=1
LOG_CLIENT_IP_HEADERS=true

# Browsers allowed to call this API (the two Netlify sites), comma-separated, https only.
CORS_ALLOWED_ORIGINS=<ADMIN_SITE_URL>,<SHOP_SITE_URL>
CSRF_TRUSTED_ORIGINS=
DJANGO_ADMIN_PATH=

# HTTPS (Render serves HTTPS on *.onrender.com)
SECURE_HSTS_SECONDS=86400

# Rate limits shared by all gunicorn workers (needs `createcachetable`, docs §4)
DJANGO_CACHE=database
ANON_THROTTLE_RATE=1000/min

# No email on staging: password reset stays off (customers are told to contact the store).
PASSWORD_RESET_ENABLED=false

# Orders: placeholder fee until the owner confirms.
ORDER_DELIVERY_FEE=150.00
ORDER_FREE_DELIVERY_FROM=

# gunicorn on the 512 MB free instance
GUNICORN_WORKERS=2
