# Production environment for the API (/etc/alzaryab/api.env, chmod 600). Every value here is a
# placeholder: fill in real values; never commit the real file.

DJANGO_DEBUG=False
# python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=API_DOMAIN
DJANGO_BEHIND_PROXY=true
CSRF_TRUSTED_ORIGINS=https://API_DOMAIN
CORS_ALLOWED_ORIGINS=https://ADMIN_DOMAIN
# Optional, once HTTPS works everywhere: SECURE_HSTS_SECONDS=31536000
DJANGO_LOG_LEVEL=INFO
# Share rate limits between gunicorn workers (then run: manage.py createcachetable)
DJANGO_CACHE=database

# PostgreSQL: password authentication (scram-sha-256), never trust
DB_NAME=alzaryab_db
DB_USER=alzaryab_user
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_CONN_MAX_AGE=60

# Email for password reset codes (any SMTP provider)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=Al Zaryab <no-reply@STORE_DOMAIN>

# Orders (confirm with the store)
ORDER_DELIVERY_FEE=150.00
ORDER_FREE_DELIVERY_FROM=
