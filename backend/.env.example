# Copy to .env and fill in real values. Never commit .env.

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
DB_NAME=alzaryab_db
DB_USER=alzaryab_user
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Comma-separated origins allowed to call the API (React admin portal)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# JWT lifetimes (optional)
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# Orders (placeholders until the store confirms them)
ORDER_DELIVERY_FEE=150.00
# Free delivery from this subtotal (leave empty to always charge)
ORDER_FREE_DELIVERY_FROM=
