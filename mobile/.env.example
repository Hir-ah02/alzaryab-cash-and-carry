# Copy to .env.local (git-ignored) only if the automatic address doesn't work.
#
# Leave EXPO_PUBLIC_API_URL unset during development: the app then talks to the
# Django server on the same computer that runs `npx expo start`, on port 8000.
#
# Set it when you need a specific server, e.g.:
#   EXPO_PUBLIC_API_URL=http://10.0.2.2:8000/api        # Android emulator
#   EXPO_PUBLIC_API_URL=http://<your-mac-lan-ip>:8000/api  # phone on the same Wi-Fi
#   EXPO_PUBLIC_API_URL=https://api.example.com/api       # a deployed server (release builds accept https:// only;
#                                                          # set it as an EAS environment variable, not here)
#
# This value is built into the app in plain text. Never put secrets in EXPO_PUBLIC_ variables.
EXPO_PUBLIC_API_URL=
